# Environment variables for NEXUS Portfolio (Vite)
# Prefix with VITE_ to be exposed to client-side code
VITE_API_BASE_URL=https://api.example.com
VITE_GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# Audio asset overrides (optional)
VITE_AUDIO_ZONE_ORIGINS=/audio/zone/origins.mp3
VITE_AUDIO_ZONE_TRAINING=/audio/zone/training.mp3
# Add additional VITE_AUDIO_ZONE_<NAME> as needed
